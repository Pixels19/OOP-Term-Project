import random
import string

class MoralMachine:
    """
    Simulates moral decision-making for an autonomous vehicle in accident scenarios.
    """
    def __init__(self):
        """
        Initializes the MoralMachine class with character mappings.
        """
        self.character_map = {
            'a': 'Man', 'b': 'Woman', 'c': 'Boy', 'd': 'Girl',
            'e': 'Elderly Man', 'f': 'Elderly Woman', 'g': 'Obese Man', 'h': 'Obese Woman',
            'i': 'Male Executive', 'j': 'Female Executive', 'k': 'Male Doctor', 'l': 'Female Doctor',
            'm': 'Male Jogger', 'n': 'Female Jogger', 'o': 'Pregnant Woman', 'p': 'Homeless Person',
            'q': 'Criminal', 'r': 'Baby', 's': 'Dog', 't': 'Cat'
        }

    def decideSwerve(self, scenario, group1, group2):
        """
        Decides whether the car should swerve based on the scenario and groups.

        Args:
            scenario (int): The scenario code (00-22).
            group1 (str): Characters representing the first group.
            group2 (str): Characters representing the second group.

        Returns:
            bool: True if the car should swerve, False otherwise.

        Criteria:
            1. Saving More Lives
            2. Protecting Passengers (Scenario)
            3. Age Preference
            4. Social Value Preference
        """
        # 1. Saving More Lives
        lives_group1 = len(group1)
        lives_group2 = len(group2)
        if lives_group2 < lives_group1:
            return True  # Swerve to save more lives

        # 2. Protecting Passengers
        if 10 <= scenario <= 12:  # Scenarios where swerving hits passengers
            return False  # Don't swerve to protect passengers

        # 3. Age Preference (Prioritize younger lives)
        young_group1 = sum(1 for char in group1 if char in 'cdrab')
        young_group2 = sum(1 for char in group2 if char in 'cdrab')
        if young_group2 < young_group1:
            return True  # Swerve to save younger individuals

        # 4. Social Value Preference
        socially_valued_group1 = sum(1 for char in group1 if char in 'ijkl')
        socially_valued_group2 = sum(1 for char in group2 if char in 'ijkl')
        socially_disvalued_group1 = sum(1 for char in group1 if char in 'pq')
        socially_disvalued_group2 = sum(1 for char in group2 if char in 'pq')

        if socially_valued_group2 > socially_valued_group1:
            return True  # Swerve to save those with higher social value
        elif socially_disvalued_group2 > socially_disvalued_group1:
            return False  # Don't swerve to avoid saving those with lower social value

        return False  # Default: Don't swerve

    def testAlgorithm(self, num_scenarios):
        """
        Tests the algorithm over a number of scenarios.

        Args:
            num_scenarios (int): The number of scenarios to test.

        Returns:
            list: A list of floats representing the percentage of each
                  type of person/animal killed.
        """
        kill_counts = {char: 0 for char in self.character_map}
        total_counts = {char: 0 for char in self.character_map}

        for _ in range(num_scenarios):
            scenario = getScenario()
            group1 = getGroup()
            group2 = getGroup()

            if self.decideSwerve(scenario, group1, group2):
                killed_group = group2
            else:
                killed_group = group1

            for char in group1 + group2:
                total_counts[char] += 1
            for char in killed_group:
                kill_counts[char] += 1

        results = []
        for char in sorted(self.character_map.keys()):
            if total_counts[char] > 0:
                results.append(kill_counts[char] / total_counts[char])
            else:
                results.append(0.0)  # Avoid division by zero
        return results


def getScenario():
    """
    Randomly chooses a scenario and legal complications.

    Returns:
        int: An integer representing the scenario (00-22).
             Tens digit: Legal complications (0, 1, or 2).
             Ones digit: Scenario type (0, 1, or 2).
    """
    scenario = random.randint(0, 2)  # 0, 1, or 2
    legal = random.randint(0, 2)  # 0, 1, or 2
    return legal * 10 + scenario


def getGroup():
    """
    Randomly generates a group of people/animals.

    Returns:
        str: A string representing the group composition.
             e.g., "abcd" for a group of 4.
    """
    group_size = random.randint(1, 5)  # Group size between 1 and 5
    group_chars = ''.join(random.choice(string.ascii_lowercase[:20]) for _ in range(group_size))
    return group_chars


if __name__ == "__main__":
    machine = MoralMachine()
    num_scenarios = 1000
    results = machine.testAlgorithm(num_scenarios)

    print(f"Results after {num_scenarios} scenarios:")
    chars = sorted(machine.character_map.keys())
    for i in range(len(chars)):
        print(f"  {machine.character_map[chars[i]]}: {results[i]:.2f}")
